# Copy to .env and fill in before production deploy:
#   cp .env.production.example .env

# --- Public URL (must match how users reach the UI) ---
CORS_ORIGINS=https://kafkaesque.example.com
KAFKAESQUE_HTTP_PORT=80
# KAFKAESQUE_HTTPS_PORT=443

# --- PostgreSQL (internal to Docker network) ---
POSTGRES_DB=kafkaesque
POSTGRES_USER=kafkaesque
POSTGRES_PASSWORD=change-me-use-openssl-rand-base64-32

# --- Backend secrets (generate — see scripts/generate-secrets.sh) ---
APP_ENV=production
JWT_SECRET=change-me-min-32-characters-random-string
# Exactly 32 bytes — run: openssl rand -hex 16
ENCRYPTION_KEY=change-me-32-byte-encryption-key!!

# Bootstrap admin (used only on first startup if no admin exists)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=change-me-strong-admin-password

# Optional
SESSION_TTL_HOURS=8

# --- Enterprise SSO (optional) ---
OIDC_ENABLED=false
OIDC_ISSUER=https://login.example.com/realms/kafkaesque
OIDC_CLIENT_ID=kafkaesque
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://kafkaesque.example.com/api/v1/auth/oidc/callback
OIDC_DEFAULT_ROLE=VIEWER
LOCAL_LOGIN_ENABLED=true
